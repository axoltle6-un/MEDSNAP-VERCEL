# MedSnap Environment Variables
# Copy this file to .env.local and fill in your values

# Firebase client config (from Firebase Console → Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK
# Option A: File path (for local dev)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option B: Inline JSON (for Vercel — paste full JSON on one line)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# SMTP (for email verification codes)
# Gmail: use App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MedSnap <your-email@gmail.com>

# Database (local only — Vercel uses Firestore)
DATABASE_URL=file:./db/custom.db

# AI API Keys
# Get LLM7 key: https://llm7.io (free, text-only)
LLM7_API_KEY=
# Get Mistral key: https://console.mistral.ai (free, vision-capable)
MISTRAL_API_KEY=

# Stripe (optional — for real payments)
# Get keys: https://dashboard.stripe.com/apikeys
# If not set, the app uses Demo Mode for Pro activation
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Create products in Stripe Dashboard → Products
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
